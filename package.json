{
  "name": "dsh-theme-toggle",
  "version": "0.1.0",
  "description": "DSH 一键深浅色切换：侧栏底部注入 36px 太阳/月亮图标按钮，点击即在浅色与深色间切换，偏好经设置作用域持久化，设置页「外观」行自动同步。One-click light/dark toggle button for DeepSeek Harness.",
  "license": "MIT",
  "type": "module",
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-primitives",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-theme"
      ],
      "platform": "web"
    }
  },
  "peerDependencies": {
    "cordis": ">=4.0.0-rc <5"
  },
  "engines": {
    "node": "^22.15.0 || >=24.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jackxiao17/dsh-theme-toggle.git"
  },
  "homepage": "https://github.com/jackxiao17/dsh-theme-toggle#readme",
  "bugs": {
    "url": "https://github.com/jackxiao17/dsh-theme-toggle/issues"
  },
  "keywords": [
    "deepseek",
    "harness",
    "dsh",
    "dsh-plugin",
    "plugin",
    "theme",
    "dark-mode",
    "light-mode"
  ]
}
